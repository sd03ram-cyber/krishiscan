# Example environment variables for KrishiScan
# Copy to `.env` and fill in your keys, then run the server.

# Roboflow model API key (optional)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=plant-disease-detection-nkbjm/1

# OpenWeatherMap API key (optional)
OPENWEATHER_API_KEY=

# NVIDIA Integrate API key (optional) — used by `nvidia_api.py`
NVIDIA_API_KEY=
# Optional override for the NVIDIA invoke URL
NVIDIA_INVOKE_URL=https://integrate.api.nvidia.com/v1/chat/completions
